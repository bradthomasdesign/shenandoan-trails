NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared passcode gate — TRAIL_ACCESS_CODE is what subscribers enter (sent via
# the newsletter). ACCESS_COOKIE_SECRET signs the access cookie so it can't be
# forged by just setting a cookie value in devtools; generate with:
#   openssl rand -hex 32
TRAIL_ACCESS_CODE=
ACCESS_COOKIE_SECRET=
